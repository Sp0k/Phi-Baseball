{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('hostUid').val() === auth.uid : auth.uid === data.child('hostUid').val())",

        "hostUid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },

        "startingTeam": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.uid === root.child('rooms/'+$code+'/hostUid').val() || auth.uid === newData.parent().child('hostUid').val())",
          ".validate": "newData.isString() && (newData.val() === 'A' || newData.val() === 'B')"
        },

        "state": {
          ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'active' || newData.val() === 'done')"
        },

        "factQuantity": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6"
        },

        "createdAt": {
          ".validate": "newData.val() == now || newData.isNumber()"
        },

        "teamMode": {
          ".validate": "newData.isString() && (newData.val() === 'phi' || newData.val() === 'oddsEvens')"
        },

        "gameData": {
          ".read": "auth != null",
          ".write": "auth.uid === root.child('rooms/'+$code+'/hostUid').val()",

          "strikes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },

          "turnTeam": {
            ".validate": "newData.isString() && (newData.val() === 'A' || newData.val() === 'B')"
          },

          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'normal' || newData.val() === 'finalChance' || newData.val() === 'done')"
          },

          "turnIndex": {
            "A": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "B": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          },

          "scoreboard": {
            "A": {
              "runs": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "bases": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            },
            "B": {
              "runs": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "bases": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              }
            }
          }
        },

        "players": {
          ".read": "auth != null && (root.child('rooms/'+$code+'/players/'+auth.uid).exists() || auth.uid === root.child('rooms/'+$code+'/hostUid').val())",
          "$uid": {
            ".write": "auth.uid === $uid",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "team": {
              ".validate": "newData.isString() && (newData.val() === 'A' || newData.val() === 'B')"
            },
            "joinedAt": {
              ".validate": "newData.val() == now || newData.isNumber()"
            }
          }
        },

        "factsByPlayer": {
          ".read": "auth.uid === root.child('rooms/' + $code + '/hostUid').val()",
          "$uid": {
            ".read": "auth.uid === $uid || auth.uid === root.child('rooms/' + $code + '/hostUid').val()",
            "$difficulty": {
              "$factId": {
                ".write": "auth.uid === $uid && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && root.child('rooms/' + $code + '/state').val() === 'lobby'",
                ".validate": "newData.hasChildren(['text']) && newData.child('text').isString() && newData.child('text').val().length > 0"
              }
            }
          }
        },

        "usedFacts": {
          ".read": "auth.uid === root.child('rooms/'+$code+'/hostUid').val()",
          "$uid": {
            "$level": {
              "$factId": {
                ".write": "auth.uid === root.child('rooms/'+$code+'/hostUid').val()",
                ".validate": "newData.val() === true"
              }
            }
          }
        }
      }
    }
  }
}
